         "merke": "c.",
         "ledd": [
          {
           "tekst": [
            "112 av timene til yrkesfaglig fordypning på vg2 er flyttet til vg3. 84 av timene brukes på vg3 til et valgfritt programfag fra studieforberedende utdanningsprogram (140 timer)."
           ]
          }
         ]
        },
