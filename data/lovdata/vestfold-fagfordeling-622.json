           ]
          }
         ]
        },
        {
         "merke": "b.",
         "ledd": [
          {
           "tekst": [
            "Elektro og datateknologi, studiekompetanse 3 år: Færder og Thor Heyerdahl (Vg1 Elektro- og datateknologi og Vg2 Datateknologi og elektronikk)."
           ]
          }
         ]
        },
        {
