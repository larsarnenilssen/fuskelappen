   "overskrift": "Forskrift om bruk av mobiltelefon og smartklokker, Slåtthaug vidaregåande skule, Vestland fylkeskommune",
   "merknader": [],
   "seksjoner": [],
   "paragrafer": [
    {
     "nr": "1",
     "visNr": "§ 1",
     "tittel": "Formål",
     "ledd": [
      {
       "tekst": [
        "Slåtthaug vidaregåande skule har som mål å sikre at alle elvane ved skulen har eit trygt og godt skulemiljø som fremjar helse, trivsel og læring, jf. ",
        {
         "t": "opplæringslova § 12-2",
         "l": "lov/2023-06-09-30/§12-2",
         "a": "opplaeringslova/12-2"
        },
        ". Lokale tilleggsreglar skal vere eit verkemiddel til å nå målet."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "2",
     "visNr": "§ 2",
     "tittel": "Verkeområde",
     "ledd": [
      {
       "tekst": [
        "Dei lokale tilleggsreglane gjeld alt som har med skuletida å gjere, også på ekskursjonar og skuleturar."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "3",
     "visNr": "§ 3",
     "tittel": "Bruk av mobiltelefon",
     "ledd": [
      {
       "tekst": [],
       "liste": [
        {
         "merke": "•",
         "ledd": [
          {
           "tekst": [
            "Vi har mobilhotell i alle klasserom og verkstader."
           ]
          }
         ]
        },
        {
         "merke": "•",
         "ledd": [
          {
           "tekst": [
            "Lærar bestemmer om og når mobiltelefonen skal brukast i undervisninga."
           ]
          }
         ]
        },
        {
         "merke": "•",
         "ledd": [
          {
           "tekst": [
            "Alle elevar skal legge mobiltelefonen i hotellet når timen startar. Telefonen skal vere i «ikkje-forstyrr-modus»."
           ]
          }
         ]
        },
        {
         "merke": "•",
         "ledd": [
          {
           "tekst": [
            "I friminutta kan elevane ta med telefonen sin."
           ]
          }
         ]
        }
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "4",
     "visNr": "§ 4",
     "tittel": "Bruk av smartklokker",
     "ledd": [
      {
       "tekst": [],
       "liste": [
        {
         "merke": "•",
         "ledd": [
          {
           "tekst": [
            "Lærar bestemmer om smartklokker skal samlast inn i samband med undervisning og vurderingssituasjonar."
           ]
          }
         ]
        }
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "5",
     "visNr": "§ 5",
     "tittel": "Ikraftsetjing",
     "ledd": [
      {
       "tekst": [
        "Forskrifta trer i kraft 1. august 2025."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "6",
     "visNr": "§ 6",
     "tittel": "Sanksjonar",
     "ledd": [
      {
       "tekst": [
        "Brot på dei lokale reglane kan føre til sanksjonar etter ",
        {
         "t": "§ 8",
         "l": "forskrift/2024-06-18-1455/§8"
        },
        " i ",
