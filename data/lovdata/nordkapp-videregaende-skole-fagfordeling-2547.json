    {
     "nr": "7",
     "visNr": "§ 7",
     "tittel": "Trekkordning til eksamen",
     "ledd": [
      {
       "tekst": [
        "Trekkordningen for eksamen gjelder også for elever som følger alternativ fag- og timefordeling. Yrkesfaglige opplæringsløp skal være en del av trekket i vg1 og vg2 hvor inntil 20 % av elevene trekkes ut til eksamen i et fag, sett over to år. Elevene skal opp til den obligatoriske tverrfaglige eksamenen i programfag på vg2."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    }
