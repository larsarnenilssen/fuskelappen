   "paragrafer": [
    {
     "nr": "1",
     "visNr": "§ 1",
     "tittel": "Virkeområde",
     "ledd": [
      {
       "tekst": [
        "Forskriften gjelder for videregående skoler som eies av Telemark fylkeskommune."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "2",
     "visNr": "§ 2",
     "tittel": "Formål",
     "ledd": [
      {
       "tekst": [
        "Forskriften skal tydeliggjøre hvilke fag som ligger på andre trinn enn det som går fram av den nasjonale fag- og timefordelingen for videregående opplæring."
       ]
      },
      {
       "tekst": [
        "Endringene i fag- og timefordelingen skal legge til rette for at elever kan få tilpassede opplæringsløp som gir generell studiekompetanse, eller spesiell studiekompetanse, på enkelte yrkesfaglige utdanningsprogrammer."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "3",
     "visNr": "§ 3",
     "tittel": "Tilbud med fag på avvikende trinn",
     "ledd": [
      {
       "tekst": [
        "I Telemark fylkeskommune får elevene fag på avvikende trinn innen følgende tilbud og skoler:"
