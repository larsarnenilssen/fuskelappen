     "visNr": "§ 6",
     "tittel": "Unntak",
     "ledd": [
      {
       "tekst": [
        "Fylkeskommunen kan gjøre unntak fra bestemmelsene i forskriften hvis det foreligger tungtveiende grunner."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "7",
     "visNr": "§ 7",
     "tittel": "Mindre endringer i forskriften",
     "ledd": [
      {
       "tekst": [
        "Fylkesdirektøren kan foreta mindre endringer i forskriften dersom endringene ikke påvirker elevenes rettigheter og plikter."
       ]
      }
