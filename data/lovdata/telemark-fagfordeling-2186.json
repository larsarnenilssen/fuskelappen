                "Skole: Skogmo videregående skole"
               ]
              }
             ]
            },
            {
             "merke": "-",
             "ledd": [
              {
               "tekst": [
                "Tilbud: Helse- og oppvekstfag med studiekompetanse 3 år"
               ]
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "merke": "b.",
         "ledd": [
          {
           "tekst": [
            "Naturbruk"
