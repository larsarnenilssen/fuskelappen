     "nr": "1",
     "visNr": "§ 1",
     "tittel": "Formål",
     "ledd": [
      {
       "tekst": [
        "Formålet med den endrede fag- og timefordelingen er å legge til rette for mer tilpassede opplæringsløp, og kan være et virkemiddel for å øke andelen som fullfører og består videregående opplæring."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "2",
     "visNr": "§ 2",
     "tittel": "Virkeområde",
     "ledd": [
      {
       "tekst": [
        "Forskriften gjelder alternativ fag- og timefordeling for utdanningsprogrammet YSK Marin ved Sandnessjøen videregående skole."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "3",
     "visNr": "§ 3",
     "tittel": "Virketid",
     "ledd": [
      {
       "tekst": [
        "Forskriften gjelder for elever som tas inn på utdanningsprogrammet YSK Marin ved Sandnessjøen videregående skole."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    }
   ]
