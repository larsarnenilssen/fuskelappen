        },
        {
         "tekst": [
          "Ved overtredelse av §",
          {
           "t": "§ 312",
           "l": "lov/2005-05-20-28/§312"
          },
          " eller ",
          {
           "t": "314",
           "l": "lov/2005-05-20-28/§314"
          },
          " gjelder avvergingsplikten bare når den fornærmede er under 16 år. Ved overtredelse av §",
          {
           "t": "§ 299",
           "l": "lov/2005-05-20-28/§299"
          },
          " eller ",
          {
           "t": "303",
           "l": "lov/2005-05-20-28/§303"
          },
          " gjelder avvergingsplikten ikke dersom vilkårene i ",
          {
           "t": "§ 308",
           "l": "lov/2005-05-20-28/§308"
          },
          " er oppfylt."
         ]
        },
        {
         "tekst": [
          "Brudd på avvergingsplikten straffes ikke når"
         ],
         "liste": [
          {
           "merke": "a.",
           "ledd": [
            {
             "tekst": [
              "handlingen det er tale om å avverge ikke har kommet så langt som til straffbart forsøk, jf. ",
              {
               "t": "§ 16",
               "l": "lov/2005-05-20-28/§16"
              },
              ", eller"
             ]
            }
           ]
          },
          {
           "merke": "b.",
           "ledd": [
            {
             "tekst": [
              "plikten ikke kunne oppfylles uten å utsette ham selv, hans nærmeste eller noen uskyldig for siktelse eller tiltale eller fare for liv, helse eller velferd."
             ]
            }
           ]
          }
         ]
        },
        {
         "tekst": [
          "Tredje ledd bokstav b gjelder ikke dersom fornærmede er mindreårig og den som unnlater å avverge er barnets forelder, steforelder, fosterforelder eller en annen som har daglig omsorg for barnet."
         ]
        }
