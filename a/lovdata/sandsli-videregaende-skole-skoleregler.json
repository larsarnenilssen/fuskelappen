   "merknader": [],
   "seksjoner": [],
   "paragrafer": [
    {
     "nr": "1",
     "visNr": "§ 1",
     "tittel": "Formål",
     "ledd": [
      {
       "tekst": [
        "Sandsli videregående skole har som mål å sikre at alle elvane ved skulen har eit trygt og godt skulemiljø som fremjar helse, trivsel og læring, jf. ",
        {
         "t": "opplæringslova § 12-2",
         "l": "lov/2023-06-09-30/§12-2",
         "a": "opplaeringslova/12-2"
        },
        "."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "2",
     "visNr": "§ 2",
     "tittel": "Verkeområde",
     "ledd": [
      {
       "tekst": [
        "Det lokale tillegget gjeld alle elevar ved skulen. Tillegget regulerer korleis elevane skal bruke mobiltelefon/smartklokke i opplæringssituasjonar."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "3",
     "visNr": "§ 3",
     "tittel": "Bruk av mobiltelefon",
     "ledd": [
      {
       "tekst": [],
       "liste": [
        {
         "merke": "•",
         "ledd": [
          {
           "tekst": [
            "Det praktiserast bruk av mobilhotell i alle timar."
           ]
          }
         ]
        },
        {
         "merke": "•",
         "ledd": [
          {
           "tekst": [
            "Det er lærer som avgjer om mobiltelefonen skal brukas i undervisninga."
           ]
          }
         ]
        },
        {
         "merke": "•",
         "ledd": [
          {
           "tekst": [
            "Eleven får ut telefonen i friminutt/pausar."
           ]
          }
         ]
        }
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "4",
     "visNr": "§ 4",
     "tittel": "Bruk av smartklokker",
     "ledd": [
      {
       "tekst": [],
       "liste": [
        {
         "merke": "•",
         "ledd": [
          {
           "tekst": [
            "Det er lærer som avgjer om smartklokker skal samlast inn i forbindelse med undervisning og vurderingar."
           ]
          }
         ]
        }
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "5",
     "visNr": "§ 5",
     "tittel": "Ikraftsetjing",
     "ledd": [
      {
       "tekst": [
        "Forskrifta trer i kraft 1. januar 2025."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "6",
     "visNr": "§ 6",
     "tittel": "Sanksjonar",
     "ledd": [
      {
       "tekst": [
        "Brot på dei lokale reglane kan føre til sanksjonar etter ",
        {
         "t": "§ 8",
         "l": "forskrift/2024-06-18-1455/§8"
        },
        " i ",
        {
         "t": "forskrift 18. juni 2024 nr. 1455",
         "l": "forskrift/2024-06-18-1455"
        },
        " om skulereglar i Vestland fylke."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    }
   ]
  }
 ]
}
