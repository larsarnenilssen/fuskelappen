   "paragrafer": [
    {
     "nr": "1",
     "visNr": "§ 1",
     "tittel": "Formål og verkeområde",
     "ledd": [
      {
       "tekst": [
        "Forskrifta gir informasjon om kva for skole- og feriedagar elevane har i skoleåra 2025–2026, 2026–2027 og 2027–2028. Elevane har rett og plikt til å møte på skolen på dei fastsette skoledagane."
       ]
      },
      {
       "tekst": [
        "Forskrifta gjeld for elevar ved alle vidaregåande skolar i Rogaland fylkeskommune skoleåra 2025–2026, 2026–2027 og 2027–2028. Vidaregåande opplæring for vaksne etter ",
        {
         "t": "opplæringslova kap. 18",
         "l": "lov/2023-06-09-30/kap18"
        },
        " er ikkje omfatta."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "2",
     "visNr": "§ 2",
     "tittel": "Felles datoar",
     "ledd": [
      {
       "tekst": [
        "Det er fastsett i ",
        {
         "t": "opplæringslova",
         "l": "lov/2023-06-09-30"
        },
        " at opplæringa skal strekke seg over minst 38 skoleveker innafor ei ramme på 45 samanhengande veker."
       ]
      },
      {
       "tekst": [
        "Datoar for oppstart av skoleåret, samt haustferie, vinterferie og påskeferie er felles for alle skolar."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
    },
    {
     "nr": "3",
     "visNr": "§ 3",
     "tittel": "Heimel for unntak frå skoleruta",
     "ledd": [
      {
       "tekst": [
        "Den enkelte skolen kan gjere unntak frå skoleruta i enkeltvedtak dersom det skal gjennomførast opplæring på andre dagar enn det som er fastsett i skoleruta. Skolen kan likevel ikkje gjere unntak som medfører at det ikkje er skoledagar på dagar der det skal gjennomførast nasjonale prøvar eller eksamen."
       ]
      }
     ],
     "endringer": [],
     "fotnoter": []
