    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "marked": "^18.0.14",
    "node-html-parser": "^9.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
