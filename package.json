{
  "name": "jukselappen",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Installerbar nettapp for skoleledere og lærere i videregående opplæring.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "preact": "^11.0.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "marked": "^18.1.0",
    "node-html-parser": "^9.0.4",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && tsx scripts/bygg-sokeindeks.ts && vite build && tsx scripts/sjekk-storrelse.ts",
    "build:test": "tsx scripts/bygg-sokeindeks.ts && TESTVERSJON=1 vite build --outDir dist-test",
    "build:e2e": "tsx scripts/bygg-sokeindeks.ts --mode e2e && vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:berorte": "tsx scripts/e2e/berorte.ts",
    "kilder:sjekk": "tsx scripts/kilder/sjekk.ts",
    "lenker:sjekk": "tsx scripts/lenkesjekk.ts",
    "lenker:fylker": "tsx scripts/lenker/fylker.ts",
    "kilder:varsle": "tsx scripts/kilder/varsle.ts",
    "kilder:forslag": "tsx scripts/kilder/lag-forslag.ts",
    "kilder:dokumenter": "tsx scripts/lag-kilder-md.ts",
    "kontroll:rapport": "tsx scripts/kontroll/rapport.ts",
    "kontroll:godkjenn": "tsx scripts/kilder/godkjenn.ts",
    "lag:ikoner": "tsx scripts/lag-ikoner.ts",
    "hent:grep": "tsx scripts/hent-grep.ts",
    "kobling:rapport": "tsx scripts/kobling/rapport.ts",
    "tilbud:rapport": "tsx scripts/tilbud/rapport.ts",
    "hent:udir": "tsx scripts/hent-udir.ts",
    "hent:overordnet": "tsx scripts/hent-overordnet-del.ts",
    "hent:lovdata": "tsx scripts/hent-lovdata.ts",
    "hent:elevundersokelsen": "tsx scripts/hent-elevundersokelsen.ts",
    "hent:statistikk": "tsx scripts/hent-statistikk.ts",
    "hent:ssb": "tsx scripts/hent-ssb.ts",
    "hent:skolerute": "tsx scripts/hent-skolerute.ts",
    "hent:vigo": "tsx scripts/hent-vigo.ts",
    "hent:utdanning": "tsx scripts/hent-utdanning.ts",
    "hent:ndla": "tsx scripts/hent-ndla.ts",
    "hent:nor": "tsx scripts/hent-nor.ts",
    "hent:eksamen": "tsx scripts/hent-eksamen.ts",
    "hent:inntak": "tsx scripts/hent-inntak.ts",
    "hent:nyheter": "tsx scripts/hent-nyheter.ts",
    "nyheter:prove": "tsx scripts/nyheter/prove.ts",
    "nyheter:varsle": "tsx scripts/nyheter/varsle.ts"
